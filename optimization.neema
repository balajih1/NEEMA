
meta {
    id: "urn:igigi:test:opt"
    authority: "IGIGI_LABS"
}

entity OptimizableBeam {
    // Design Space: Thickness between 1 and 10
    property thickness: Float = 1.0 .. 10.0
    
    // Constraint: Must be at least 5
    invariant min_strength {
        require( thickness > 5.0 )
    }
    
    invariant max_limit {
        require( thickness < 8.0 )
    }
}
